# Backend (server/.env)
PORT=5000
JWT_SECRET=change_this_in_production
DATABASE_URL=sqlite.db

# AI API keys - server-side only (server/.env). Never prefix with VITE_.
# GEMINI_API_KEY: free tier from https://aistudio.google.com/apikey — powers the grant quality filter
# OPENAI_API_KEY: powers the AI chat box
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENAI_MODEL=gpt-4o-mini

# Frontend (create .env in root for demo use)
VITE_API_URL=http://localhost:5000