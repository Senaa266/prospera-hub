# Backend (server/.env)
PORT=5000
JWT_SECRET=change_this_in_production
DATABASE_URL=sqlite.db

# AI API keys — put these in server/.env only. Never prefix with VITE_
# (a VITE_ key is bundled into the browser).
# GEMINI_API_KEY: https://aistudio.google.com/apikey — Sena chat + grant filter
# OPENAI_API_KEY: optional fallback if Gemini is unset
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Frontend (create .env in root for demo use)
VITE_API_URL=http://localhost:5000